{
  "manifest_version": 2,
  "name": "Swift Sync",
  "version": "1.0.0",
  "description": "End-to-end encrypted, zero-cloud LAN bookmark & tab synchronization with Swift Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sync@swiftbrowser.app",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "tabs",
    "notifications",
    "http://*/*",
    "https://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Swift Sync"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}